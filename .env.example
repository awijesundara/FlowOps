# ServiceOps REST API base. Never commit the bearer token.
SERVICEOPS_URL=http://host.docker.internal:8080
FLOWOPS_BOOTSTRAP_PASSWORD=replace-with-a-strong-unique-admin-password
# Generate once with: python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FLOWOPS_SETTINGS_ENCRYPTION_KEY=
FLOWOPS_PUBLIC_URL=http://localhost:8088
FLOWOPS_SMTP_HOST=
FLOWOPS_SMTP_PORT=587
FLOWOPS_SMTP_SECURITY=starttls
FLOWOPS_SMTP_USERNAME=
FLOWOPS_SMTP_PASSWORD=
FLOWOPS_MAIL_FROM=
